---
import { releases } from '../data/releases';
import Landing from '../layouts/Landing.astro';
import { RELEASES } from '../lib/downloads';
---

<Landing
  title="Changelog: Dispatch releases"
  description="What changed in each Dispatch release."
  path="/changelog"
>
  <div class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>Changelog</h1>
        <p class="lede">
          What each release changed. Downloads and full notes are on <a href={RELEASES}>GitHub</a>.
        </p>
      </div>
      <ol class="log">
        {
          releases.map((r) => (
            <li>
              <p class="v">
                <code>{r.v}</code>
              </p>
              <div>
                <h2>{r.title}</h2>
                <ul>
                  {r.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Landing>

<style>
  .log {
    max-width: 52rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: 0;
    list-style: none;
  }
  .log > li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .v code {
    color: var(--accent-ink);
    font-size: 1rem;
  }
  .log h2 {
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  .log ul {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    color: var(--ink-soft);
  }
  .log ul li {
    margin: 0.45rem 0;
  }
  @media (width < 640px) {
    .log > li {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
