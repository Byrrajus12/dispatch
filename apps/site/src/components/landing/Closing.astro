---
import { DMG, RELEASES } from '../../lib/downloads';
import InstallCommand from './InstallCommand.astro';

const demo = 'https://dispatch-demo-production-aed7.up.railway.app';

// Real screenshots of the desktop app on the demo project, one per tab.
const shots = [
  ['tasks', 'Tasks', 'Every task grouped by milestone, with what needs you pinned on top.'],
  ['live', 'Live', 'Agents working in waves. A blocked task starts the moment its blocker lands.'],
  ['review', 'Review', 'The diff, the reviewer’s findings and the merge button, side by side.'],
  ['board', 'Board', 'The same tasks as columns, from draft to landed.'],
  ['overseer', 'Overseer', 'One conversation with the project, with what is coming in and going out beside it.'],
] as const;
---

<section class="feature" id="demo" aria-labelledby="demo-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="demo-title">The real app. <em>Nothing here is a mockup.</em></h2>
      <p>
        Screenshots of Dispatch on a demo project, the same build you download. Pick a view, or{' '}
        <a href={demo} target="_blank" rel="noopener">try it live in your browser</a>.
      </p>
    </div>
    <div class="tour" data-tour>
      <div class="tabs" role="tablist" aria-label="App views">
        {
          shots.map(([id, label], i) => (
            <button
              type="button"
              role="tab"
              id={`tour-tab-${id}`}
              aria-controls={`tour-${id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {label}
            </button>
          ))
        }
      </div>
      {
        shots.map(([id, label, caption], i) => (
          <figure
            class="shot"
            id={`tour-${id}`}
            role="tabpanel"
            aria-labelledby={`tour-tab-${id}`}
            hidden={i !== 0}
          >
            <div class="frame panel">
              <img
                src={`/app/${id}.webp`}
                alt={`Dispatch ${label} view: ${caption}`}
                width="2400"
                height="1500"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>{caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section class="closing" aria-labelledby="closing-title">
  <div class="wrap">
    <h2 id="closing-title">Give your agents a board.<br /><em>Available today.</em></h2>
    <p>Download the app, follow Setup, and hand over your first task.</p>
    <div class="actions">
      <InstallCommand />
      <a class="btn btn-primary" href={DMG.arm}>Download for Mac</a>
    </div>
    <p class="platforms">Apple Silicon. <a href={DMG.x64}>Intel Mac</a> and <a href={RELEASES}>Linux packages</a> are on GitHub.</p>
  </div>
</section>


<style>
  .section-head a {
    color: var(--ink);
    text-underline-offset: 3px;
  }
  .tour {
    margin: 3rem 0 0;
  }
  /* A ruled tab strip sitting on the screenshot's top edge. */
  .tabs {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    max-width: 100%;
    border: 1px solid var(--border);
    border-bottom: 0;
    background-image: var(--hatching);
  }
  .tabs button {
    flex: none;
    padding: 0.9rem clamp(0.9rem, 2.5vw, 1.4rem);
    border: 0;
    border-right: 1px solid var(--border);
    background: none;
    color: var(--ink-2);
    font: 600 0.72rem/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .tabs button:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .tabs button[aria-selected='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .tabs button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .shot {
    margin: 0;
  }
  .shot:not([hidden]) .frame {
    animation: shot-in 0.45s var(--ease);
  }
  .frame {
    overflow: hidden;
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  figcaption::before {
    content: '↳ ';
    color: var(--accent);
    font-family: var(--mono);
  }
  @keyframes shot-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot:not([hidden]) .frame {
      animation: none;
    }
  }

  /* The closing shout gets the most air: two mono lines, the second one
     indigo. */
  .closing {
    position: relative;
    padding: clamp(7rem, 15vw, 12rem) 0;
    border-top: 1px solid var(--border);
  }
  .closing .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .closing h2 {
    font-size: clamp(2rem, 6.2vw, 6rem);
    letter-spacing: -0.05em;
  }
  .closing h2 em {
    color: var(--accent);
  }
  .closing p {
    max-width: 34rem;
    margin: 1.75rem 0 0;
    color: var(--ink-2);
    font-size: 1.2rem;
  }
  .closing .platforms {
    margin: 1rem 0 0;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .platforms a {
    color: var(--ink-2);
    text-underline-offset: 3px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

</style>

<script>
  // Tabs for the screenshot tour: click or arrow keys switch the shown view.
  for (const tour of document.querySelectorAll<HTMLElement>('[data-tour]')) {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (next: HTMLButtonElement) => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (step === 0) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  }
</script>
