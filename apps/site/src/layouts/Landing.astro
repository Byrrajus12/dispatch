---
import '@fontsource-variable/geist';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

import Footer from '../components/site/Footer.astro';
import Nav from '../components/site/Nav.astro';
import {
  breadcrumbs,
  DESCRIPTION,
  ldJson,
  organization,
  SITE,
  softwareApplication,
  website,
} from '../lib/seo';
import '../styles/site.css';

// The frame every marketing page shares: head tags, nav, footer. The protocol
// pages keep Base.astro.
interface Props {
  // The 404 page: kept out of search and given no canonical link.
  notFound?: boolean;
  title?: string;
  description?: string;
  // The page's site path, for its canonical and preview URL.
  path?: string;
  // Extra schema.org nodes for this page, beside the site-wide ones.
  jsonLd?: object[];
}
const {
  notFound = false,
  title: pageTitle,
  description: pageDescription,
  path = '/',
  jsonLd = [],
} = Astro.props;
const title = notFound
  ? 'Page not found: Dispatch'
  : (pageTitle ?? 'Dispatch: an Overseer for your coding agents');
const description = pageDescription ?? DESCRIPTION;
const url = `${SITE}${path}`;
// Breadcrumb names come from the path; an acronym path gets its name spelled out.
const CRUMBS: Record<string, string> = { '/faq': 'FAQ' };
const crumb = (p: string) =>
  CRUMBS[p] ?? p.slice(1, 2).toUpperCase() + p.slice(2);
const graph = [
  organization,
  website,
  ...(path === '/' && !notFound ? [softwareApplication()] : []),
  ...(path !== '/' && !notFound
    ? [breadcrumbs([['Dispatch', '/'], [crumb(path), path]])]
    : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={notFound ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!notFound && <link rel="canonical" href={url} />}
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dispatch" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://dispatch.foo/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dispatch: the Overseer flags you when a task needs you." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://dispatch.foo/og.png" />
    <script type="application/ld+json" set:html={ldJson(graph)}></script>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f9f9fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f11" />
    <!-- Applies a stored theme choice before first paint. No choice stored means the OS
         setting applies. -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('dispatch-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (_) {
          /* Storage is unavailable. The OS setting applies. */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
