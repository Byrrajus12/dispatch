---
import Landing from '../layouts/Landing.astro';
---

<Landing notFound>
  <div class="page missing">
    <div class="wrap">
      <h1>This page isn’t here.</h1>
      <p class="lede">It moved, or it described something Dispatch no longer does.</p>
      <a class="btn btn-primary" href="/">Go to the home page</a>
    </div>
  </div>
</Landing>

<style>
  .missing {
    padding-block: clamp(6rem, 14vw, 10rem);
  }
  .lede {
    max-width: 32rem;
    margin: 1.25rem 0 2rem;
    color: var(--muted);
    font-size: 1.15rem;
  }
</style>
