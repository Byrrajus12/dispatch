---
import AppDemo from './AppDemo.astro';
import { DMG, RELEASES } from '../../lib/downloads';
import InstallCommand from './InstallCommand.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="copy">
      <h1 id="hero-title">Give agents tasks, <em>not chats.</em></h1>
      <div class="sub">
        <p class="lede">
          The shared board your team’s agents work from, on your own machines. Plan in one
          sentence, watch agents work through it, and see exactly what stands between you and v1.
        </p>
        <a class="new" href="#two-views"><b>New</b> Overseer topic routing <span aria-hidden="true">→</span></a>
      </div>
      <div class="actions" id="install">
        <a class="btn btn-primary" href={DMG.arm}>Download for Mac</a>
        <InstallCommand />
      </div>
      <p class="alt">
        Apple Silicon. <a href={DMG.x64}>Intel Mac</a> or <a href={RELEASES}>Linux</a>.
      </p>
    </div>
  </div>

  <div class="stage">
    <div class="tilt">
      <AppDemo />
    </div>
  </div>
</section>

<style>
  .alt {
    margin-top: 0.9rem;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .alt a {
    color: var(--ink-2);
    text-underline-offset: 3px;
  }
  .alt a:hover {
    color: var(--accent);
  }
  .hero {
    position: relative;
    padding: clamp(4rem, 10vw, 8rem) 0 0;
    overflow: hidden;
  }
  h1 {
    max-width: 12ch;
  }
  .sub {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-top: 1.75rem;
  }
  .lede {
    max-width: 36rem;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.45;
    text-wrap: pretty;
  }
  /* The release note: a ruled mono strip that floods on hover. */
  .new {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--border);
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .new b {
    color: var(--accent);
    font-weight: 700;
  }
  .new:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  .new:hover b {
    color: var(--on-accent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
    scroll-margin-top: 6rem;
  }

  /* The app runs off the right edge of the page and fades into it, so it
     reads as a window onto something larger than the screen. */
  .stage {
    position: relative;
    width: calc(100% - max(var(--gutter), (100% - var(--max)) / 2));
    margin: clamp(3.5rem, 7vw, 5rem) 0 0 auto;
    padding-bottom: clamp(3rem, 6vw, 5rem);
    perspective: 2400px;
    mask-image:
      linear-gradient(to right, #000 82%, transparent),
      linear-gradient(to bottom, #000 78%, transparent);
    mask-composite: intersect;
  }
  .stage :global(.win) {
    width: max(100%, 74rem);
  }
  .tilt {
    position: relative;
    transform-origin: 0% 0%;
  }
  /* The window starts tilted back and lies flat as the reader scrolls to it. */
  @supports (animation-timeline: view()) {
    .tilt {
      animation: flatten linear both;
      animation-range: entry 0% cover 40%;
      animation-timeline: view();
    }
  }
  @keyframes flatten {
    from {
      transform: rotateX(22deg) rotateY(-8deg) scale(0.92);
    }
    to {
      transform: none;
    }
  }
  @media (max-width: 720px) {
    .stage {
      width: calc(100% - var(--gutter));
      mask-image: linear-gradient(to bottom, #000 85%, transparent);
    }
    .stage :global(.win) {
      width: 100%;
    }
  }
</style>
