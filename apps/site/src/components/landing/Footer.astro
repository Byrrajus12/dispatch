---
// The site footer: the mark, then link columns.
const columns: [string, [string, string][]][] = [
  ['Product', [['Overseer', '/#two-views'], ['Tasks', '/#board'], ['Milestones', '/#milestones'], ['Memory', '/#memory'], ['Tour', '/#demo'], ['Clips', '/clips']]],
  ['Agents', [['MCP server', '/#mcp'], ['Agent to agent', '/#a2a'], ['Docs', '/docs'], ['Pricing', '/pricing'], ['FAQ', '/faq'], ['Changelog', '/changelog']]],
  ['Protocol', [['Dispatch Messaging Protocol', '/protocol/'], ['A2A envelope extension', '/a2a/ext/envelope/v1'], ['A2A work extension', '/a2a/ext/work/v1']]],
  ['Get it', [['Download', 'https://github.com/wsoule/dispatch/releases/latest'], ['Releases', 'https://github.com/wsoule/dispatch/releases'], ['GitHub', 'https://github.com/wsoule/dispatch'], ['Contact', 'mailto:hello@dispatch.foo'], ['Privacy', '/privacy']]],
];
---

<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <span class="mark"><span class="glyph" aria-hidden="true"></span>Dispatch</span>
      <p>
        Built with itself: commits tagged <code>(run r-…)</code> in the repo were written by
        Dispatch’s own agents.
      </p>
    </div>
    {
      columns.map(([title, links]) => (
        <nav aria-label={title}>
          <h3>{title}</h3>
          {links.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
      ))
    }
  </div>
  <div class="wrap bottom">
    <span>© {new Date().getFullYear()} Dispatch</span>
    <span>Open core · MIT · FSL-1.1-ALv2</span>
  </div>
</footer>

<style>
  /* A full-bleed indigo flood: the nav can turn indigo, the footer is. */
  .footer {
    padding: 4.5rem 0 0;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.9rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(4, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }
  .brand {
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .brand p {
    max-width: 18rem;
    font-weight: 400;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .glyph {
    width: 0.85rem;
    height: 0.85rem;
    background: var(--on-accent);
  }
  nav {
    display: grid;
    align-content: start;
    gap: 0.65rem;
  }
  h3 {
    margin-bottom: 0.35rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  a {
    font-weight: 400;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 4rem;
    padding-block: 1.25rem;
    border-top: 1px solid rgb(11 11 12 / 30%);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
