---
// The Homebrew install command with a copy button; the hero and the closing
// section both show it.
const command = 'brew install --cask wsoule/tap/dispatch';
---

<div class="install">
  <code><span class="prompt" aria-hidden="true">$</span> {command}</code>
  <button type="button" data-copy={command} aria-label="Copy the install command">Copy</button>
</div>

<style>
  /* The one accent-ruled box on the page: the command that matters most. */
  .install {
    display: inline-flex;
    align-items: stretch;
    max-width: 100%;
    min-height: 3rem;
    border: 2px solid var(--accent);
    background: var(--bg);
  }
  code {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    padding: 0 1rem;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.85rem;
    scrollbar-width: none;
  }
  .prompt {
    color: var(--accent);
    user-select: none;
  }
  button {
    flex: none;
    min-width: 5.5rem;
    padding: 0 1rem;
    border: 0;
    border-left: 2px solid var(--accent);
    background: none;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  button:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>

<script>
  // Binds every [data-copy] button on the page, not only this one.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = btn.textContent ?? 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => {
        btn.textContent = label;
      }, 1500);
    });
  }
</script>
