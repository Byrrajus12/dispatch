---
import { releases as all } from '../../data/releases';

// The four newest releases; /changelog has the rest.
const releases = all.slice(0, 4);
---

<section class="feature" id="changelog" aria-labelledby="changelog-title">
  <div class="wrap">
    <h2 id="changelog-title">Changelog</h2>
    <ol class="releases">
      {
        releases.map((r, i) => (
          <li>
            <span class:list={['pip', i === 0 && 'latest']} aria-hidden="true" />
            <b>{r.title}</b>
            <p>{r.text}</p>
            <p class="meta">
              <code>{r.v}</code> {r.date}
            </p>
          </li>
        ))
      }
    </ol>
    <a class="all" href="/changelog">All releases</a>
  </div>
</section>

<style>
  /* Four ruled cells on one baseline; hovering one floods it indigo. */
  .releases {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 4rem);
    padding: 1px 0 0 1px;
    list-style: none;
  }
  li {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.6rem;
    margin: -1px 0 0 -1px;
    padding: 1.4rem 1.4rem 1.6rem;
    border: 1px solid var(--border);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  li:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .pip {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--ink-3);
  }
  .pip.latest {
    background: var(--accent);
  }
  li:hover .pip {
    background: var(--on-accent);
  }
  b {
    font-weight: 600;
    line-height: 1.3;
  }
  li p {
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  li:hover p {
    color: inherit;
  }
  li .meta {
    padding-top: 0.8rem;
    border-top: 1px solid var(--line-2);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  li:hover .meta {
    border-color: currentColor;
  }
  .meta code {
    color: var(--accent);
    font-size: 1em;
    font-weight: 700;
  }
  li:hover .meta code {
    color: inherit;
  }
  .all {
    display: inline-block;
    margin-top: 2rem;
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .all::after {
    content: ' →';
    color: var(--accent);
  }
  .all:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 900px) {
    .releases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .releases {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
