---
import { INSTALL } from '../../lib/downloads';

// The one-line macOS install with a copy button. The home hero, the closing
// section and /download show it.
---

<div class="install">
  <code><span class="prompt" aria-hidden="true">$</span> {INSTALL}</code>
  <button type="button" data-copy={INSTALL} aria-label="Copy the install command">Copy</button>
</div>

<style>
  .install {
    display: flex;
    align-items: stretch;
    max-width: 100%;
    min-height: 2.75rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--code-bg);
    color: var(--code-ink);
  }
  code {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.7rem 1rem;
    overflow-x: auto;
    font-size: 0.88rem;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .prompt {
    color: #8b93f0;
    user-select: none;
  }
  button {
    flex: none;
    min-width: 4.75rem;
    padding: 0 1rem;
    border: 0;
    border-left: 1px solid rgb(255 255 255 / 12%);
    background: none;
    color: inherit;
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
  }
  button:hover {
    background: rgb(255 255 255 / 8%);
  }
  button:focus-visible {
    outline-offset: -3px;
  }
</style>

<script>
  // Binds every [data-copy] button on the page.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = btn.textContent ?? 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select it';
      }
      setTimeout(() => {
        btn.textContent = label;
      }, 1500);
    });
  }
</script>
