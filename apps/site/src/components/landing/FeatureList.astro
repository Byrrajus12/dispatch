---
// A section's footnote of features: names in two columns, each opening to a
// one-line explanation with its "+".
interface Props {
  items: [string, string][];
}
const { items } = Astro.props;
---

<div class="features">
  <p class="features-label">Features</p>
  <div class="features-grid">
    {
      items.map(([name, text]) => (
        <details>
          <summary>
            {name}
            <span class="plus" aria-hidden="true" />
          </summary>
          <p>{text}</p>
        </details>
      ))
    }
  </div>
</div>

<style>
  .features {
    display: grid;
    gap: 1rem 4rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .features-label {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  /* A ruled grid of disclosures; shared edges collapse into one line. Hover
     floods a cell indigo, open turns it to ink. */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 1px 0 0 1px;
  }
  details {
    margin: -1px 0 0 -1px;
    border: 1px solid var(--border);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    color: inherit;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  details[open] {
    background: var(--ink);
    color: var(--bg);
  }
  /* A plus that turns into a cross when open. */
  .plus {
    position: relative;
    width: 0.6rem;
    height: 0.6rem;
    flex: none;
    transition: transform 200ms var(--ease);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus {
    transform: rotate(45deg);
  }
  details p {
    max-width: 30rem;
    padding: 0 1rem 1rem;
    font-size: 0.95rem;
    font-weight: 400;
    animation: open 250ms var(--ease);
  }
  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (min-width: 900px) {
    .features {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .features-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
