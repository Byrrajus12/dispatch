---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/jetbrains-mono/800.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin800 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-800-normal.woff2?url';

import {
  breadcrumbs,
  DESCRIPTION,
  ldJson,
  organization,
  SITE,
  softwareApplication,
  website,
} from '../lib/seo';
import '../styles/landing.css';

// The home page's own frame. The protocol pages keep Base.astro and the app's
// tokens; the landing page is always dark: a spec sheet printed in negative.
interface Props {
  // The 404 page: kept out of search and given no canonical link.
  notFound?: boolean;
  title?: string;
  description?: string;
  // The page's site path, for its canonical and preview URL.
  path?: string;
  // Extra schema.org nodes for this page, beside the site-wide ones.
  jsonLd?: object[];
}
const {
  notFound = false,
  title: pageTitle,
  description: pageDescription,
  path = '/',
  jsonLd = [],
} = Astro.props;
const title = notFound
  ? 'Page not found: Dispatch'
  : (pageTitle ?? 'Dispatch: the shared task board for AI coding agents');
const description = pageDescription ?? DESCRIPTION;
const url = `${SITE}${path}`;
const crumb = (p: string) => p.slice(1, 2).toUpperCase() + p.slice(2);
// Every page carries the organization and site; the home page adds the app,
// and every other page a breadcrumb back home named by its path.
const graph = [
  organization,
  website,
  ...(path === '/' && !notFound ? [softwareApplication()] : []),
  ...(path !== '/' && !notFound
    ? [breadcrumbs([['Dispatch', '/'], [crumb(path), path]])]
    : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={notFound ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin800} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!notFound && <link rel="canonical" href={url} />}
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dispatch" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://dispatch.foo/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dispatch: give agents tasks, not chats." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://dispatch.foo/og.png" />
    <script type="application/ld+json" set:html={ldJson(graph)}></script>
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
  </head>
  <body>
    <slot />
    <script>
      // Starts each [data-seq-root] sequence the first time it is on screen.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('play');
            io.unobserve(e.target);
          }
        },
        { threshold: 0.35 }
      );
      for (const el of document.querySelectorAll('[data-seq-root]')) io.observe(el);

      // A section scrolled out of view sets data-idle, which pauses every CSS
      // animation inside it, so the page does no work for what nobody sees.
      const idle = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.target.toggleAttribute('data-idle', !e.isIntersecting);
        },
        { rootMargin: '200px 0px' }
      );
      for (const el of document.querySelectorAll('main > section')) idle.observe(el);

      // The nav lifts off the top edge into a floating box once the page scrolls.
      const root = document.documentElement;
      const syncNav = () => root.classList.toggle('nav-detached', scrollY > 6);
      addEventListener('scroll', syncNav, { passive: true });
      syncNav();
    </script>
  </body>
</html>
