---
import { pricingFaq } from '../data/faq';
import Landing from '../layouts/Landing.astro';
import { DMG, TEAM_SERVER } from '../lib/downloads';
import { faqPage } from '../lib/seo';

const plans = [
  {
    name: 'Solo',
    price: '$0',
    per: 'free, for as long as you like',
    points: [
      'Your machine and your agents',
      'Every local feature: the Overseer, the board, runs, pull requests, planning',
      'Claude Code and Codex with your own sign-in or key',
      'Two-way Linear sync',
      'Panels and themes you can change',
    ],
    cta: ['Download for Mac', DMG],
  },
  {
    name: 'Team',
    price: '$10',
    per: 'per seat per month, billed through Stripe',
    points: [
      'Everything in Solo, for each person',
      'The hosted team server at team.dispatch.foo',
      'Shared projects with boards in sync',
      'Your teammates’ agents beside your own',
      'One lead per project',
      'Only end-to-end encrypted data on the server',
    ],
    cta: ['Start a team', TEAM_SERVER],
  },
] as const;
---

<Landing
  title="Pricing: Dispatch is free alone, $10 per seat for teams"
  description="Solo is free with every local feature. Team is $10 per seat per month on the hosted team server."
  path="/pricing"
  jsonLd={[faqPage(pricingFaq)]}
>
  <div class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>Free on your own. $10 a seat with a team.</h1>
        <p class="lede">
          Everything that runs on your machine is free. You pay only for the hosted server a team
          shares.
        </p>
      </div>

      <div class="plans">
        {
          plans.map((p, i) => (
            <section class:list={['plan', i === 1 && 'team']} aria-labelledby={`plan-${p.name}`}>
              <h2 id={`plan-${p.name}`}>{p.name}</h2>
              <p class="price">
                {p.price} <span>{p.per}</span>
              </p>
              <ul>
                {p.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <a class:list={['btn', i === 0 && 'btn-primary']} href={p.cta[1]}>
                {p.cta[0]}
              </a>
            </section>
          ))
        }
      </div>

      <div class="prose">
        <h2>Questions</h2>
        <dl class="qa">
          {
            pricingFaq.map(([q, a]) => (
              <div>
                <dt>{q}</dt>
                <dd>{a}</dd>
              </div>
            ))
          }
        </dl>
        <p>
          The team server’s <a href={`${TEAM_SERVER}/terms`}>terms</a> and{' '}
          <a href={`${TEAM_SERVER}/privacy`}>privacy policy</a> cover what you agree to when you
          start a team. Questions: <a href="mailto:hello@dispatch.foo">hello@dispatch.foo</a>.
        </p>
      </div>
    </div>
  </div>
</Landing>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
    max-width: 56rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .plan {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .plan.team {
    border-color: var(--line-strong);
  }
  .plan h2 {
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .price {
    margin-top: 0.75rem;
    font-size: 2.4rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .price span {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  .plan ul {
    flex: 1;
    margin: 1.5rem 0 1.75rem;
    padding-left: 1.1rem;
    color: var(--ink-soft);
  }
  .plan li {
    margin: 0.45rem 0;
  }
  .plan .btn {
    align-self: flex-start;
  }
</style>
