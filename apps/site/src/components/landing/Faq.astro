---
// Short answers to what people ask about Dispatch, always visible so search
// and AI answer engines can quote them. index.astro marks them up as FAQPage.
import { homeFaq } from '../../data/faq';
---

<section class="feature" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <h2 id="faq-title">Questions. <em>Short answers.</em></h2>
    <dl class="faq">
      {
        homeFaq.map(([q, a]) => (
          <div>
            <dt>{q}</dt>
            <dd>{a}</dd>
          </div>
        ))
      }
    </dl>
    <p class="more"><a href="/faq">Every question, answered: setup, agents, guardrails, teams →</a></p>
  </div>
</section>

<style>
  /* Ruled cells in two columns; shared edges collapse into one line. */
  .faq {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 4rem);
    padding: 1px 0 0 1px;
  }
  .faq div {
    margin: -1px 0 0 -1px;
    padding: 1.5rem 1.6rem 1.7rem;
    border: 1px solid var(--border);
    transition: background 0.15s ease;
  }
  /* An odd last question spans both columns rather than leave a hole. */
  .faq div:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  .faq div:hover {
    background: var(--tint);
  }
  dt {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  dt::before {
    content: 'Q ';
    color: var(--accent);
    font-family: var(--mono);
    font-weight: 800;
  }
  dd {
    margin-top: 0.6rem;
    color: var(--ink-2);
  }
  .more {
    margin-top: 1.5rem;
    font-family: var(--mono);
    font-size: 0.9rem;
  }
  .more a {
    color: var(--accent);
  }
  @media (max-width: 820px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
