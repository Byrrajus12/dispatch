---
import { faqSections } from '../data/faq';
import Landing from '../layouts/Landing.astro';
import { faqPage } from '../lib/seo';

// A stable anchor per question, so an answer can be linked on its own.
const slug = (q: string) =>
  q
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<Landing
  title="FAQ: Dispatch, an Overseer for your coding agents"
  description="Answers about Dispatch: which agents it runs, when it interrupts you, how work lands, the app, teams, pricing and licensing."
  path="/faq"
  jsonLd={[faqPage(faqSections.flatMap((s) => s.items))]}
>
  <div class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>Questions</h1>
        <p class="lede">
          What Dispatch does, what it runs and what it costs. Anything else: <a
            href="mailto:hello@dispatch.foo">hello@dispatch.foo</a
          >.
        </p>
        <nav class="jump" aria-label="FAQ sections">
          {faqSections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
        </nav>
      </div>

      <div class="prose">
        {
          faqSections.map((s) => (
            <section aria-labelledby={s.id}>
              <h2 id={s.id}>{s.title}</h2>
              <dl class="qa">
                {s.items.map(([q, a]) => (
                  <div id={slug(q)}>
                    <dt>{q}</dt>
                    <dd>{a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))
        }
        <p>Setup step by step is in the <a href="/docs">docs</a>.</p>
      </div>
    </div>
  </div>
</Landing>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
  }
  .jump a {
    color: var(--accent-ink);
    text-underline-offset: 3px;
  }
  .prose section:first-child h2 {
    margin-top: 0;
  }
</style>
